{
  "name": "@jerryc05/hi-tools",
  "version": "0.2.15",
  "description": "A collection of my everyday SDE tools.",
  "scripts": {
    "pub": "npm run build && export NPM_CONFIG_REGISTRY=https://registry.npmjs.org &&{ npm whoami || npm login ;} && npm publish --access public && git push",
    "build": "node build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerryc05/hi-tools.git"
  },
  "bin": {
    "hi": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist/*.js"
  ],
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "picocolors": "^1.1.1",
    "string-argv": "^0.3.2",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "@byted/aipaas-auth": "^0.1.0",
    "@clack/prompts": "^1.3.0",
    "base62": "^2.0.2",
    "bignumber.js": "^11.1.4",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "json-bigint": "^1.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.1",
    "tempy": "^3.2.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^5.0.6",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/yargs": "^17.0.35",
    "cli-progress": "^3.12.0",
    "esbuild": "^0.28.0",
    "fast-glob": "^3.3.3",
    "p-map": "^7.0.4",
    "trash": "^10.1.1",
    "xxhash-wasm": "^1.1.0"
  },
  "overrides": {
    "@clack/prompts": "$@clack/prompts",
    "execa": "$execa",
    "jsonwebtoken": "^9",
    "yargs": "$yargs"
  }
}
